# Generic local debug/developer tool path overrides.
# Copy or merge into tool-paths.env and customize for the local machine/project.
# Do not commit machine-specific paths unless the project explicitly intends to.

# Repository/artifact roots
PROJECT_ROOT=
BUILD_ROOT=bin
INSTALL_ROOT=
SYMBOL_ROOT=bin/x64-llvm
LOG_ROOT=.
DUMP_ROOT=.
CAPTURE_ROOT=

# Windows SDK Debugging Tools architecture roots.
# Each value should point at the corresponding Debuggers\<arch> directory.
WINDOWS_SDK_DEBUGGERS_X86=
WINDOWS_SDK_DEBUGGERS_X64=
WINDOWS_SDK_DEBUGGERS_ARM=
WINDOWS_SDK_DEBUGGERS_ARM64=

# MSVC binary-tool directories or roots containing dumpbin/link/lib/editbin/undname.
MSVC_TOOLS_X86=
MSVC_TOOLS_X64=
MSVC_TOOLS_ARM64=

# Other generic developer/debug tool roots
SYSINTERNALS_ROOT=
LLVM_ROOT=llvm-mingw-20260519-ucrt-x86_64/llvm-mingw-20260519-ucrt-x86_64/bin
FFMPEG_ROOT=

# Notes:
# - Paths may be absolute or relative to PROJECT_ROOT.
# - discover-debug-tools.ps1 reads the architecture/tool-root variables above.
# - Explicit overrides are checked before standard Windows locations and PATH.
# - Missing optional tools are recorded in debug-tool-manifest.json; discovery itself is non-mutating.

# ShaderStress notes:
# - LLVM_ROOT points at the project-pinned LLVM MinGW toolchain (keep in sync with build.py).
# - Crash reports (Crash_*/) and ShaderStress.log are written to the working directory.
