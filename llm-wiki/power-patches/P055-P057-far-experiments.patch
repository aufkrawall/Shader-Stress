diff --git a/src/workloads/SynthKernel.inc b/src/workloads/SynthKernel.inc
index b0edbc2..13f6389 100644
--- a/src/workloads/SynthKernel.inc
+++ b/src/workloads/SynthKernel.inc
@@ -96,16 +96,32 @@
         double *pb = buf + (j + s) * 2 * SK_W;
         double *pc = buf + (j + 2 * s) * 2 * SK_W;
         double *pd = buf + (j + 3 * s) * 2 * SK_W;
+#if defined(SK_PF_DIST) && SK_PF_DIST > 0
+        {
+          const size_t m_ = kVecs - 1; // experiment only: kVecs power of two
+          __builtin_prefetch(buf + ((j + SK_PF_DIST) & m_) * 2 * SK_W);
+          __builtin_prefetch(buf + ((j + s + SK_PF_DIST) & m_) * 2 * SK_W);
+          __builtin_prefetch(buf + ((j + 2 * s + SK_PF_DIST) & m_) * 2 * SK_W);
+          __builtin_prefetch(buf + ((j + 3 * s + SK_PF_DIST) & m_) * 2 * SK_W);
+#ifndef SK_PF_NOFAR
+          __builtin_prefetch(buf + (((j ^ (kVecs / 2)) + SK_PF_DIST) & m_) * 2 * SK_W);
+#endif
+        }
+#endif
         SK_VEC ar = SK_LOAD(pa), ai = SK_LOAD(pa + SK_W);
         SK_VEC br = SK_LOAD(pb), bi = SK_LOAD(pb + SK_W);
         SK_VEC cr = SK_LOAD(pc), ci = SK_LOAD(pc + SK_W);
         SK_VEC dr = SK_LOAD(pd), di = SK_LOAD(pd + SK_W);
+#ifndef SK_ABL_NOFP
         for (int r = 0; r < SYNTH_ROUNDS; ++r) {
           SK_BFLY(ar, ai, cr, ci);
           SK_BFLY(br, bi, dr, di);
           SK_BFLY_CONJ(ar, ai, br, bi);
           SK_BFLY_CONJ(cr, ci, dr, di);
         }
+#else
+        { SK_VEC t_ = ar; ar = ai; ai = br; br = bi; bi = cr; cr = ci; ci = dr; dr = di; di = t_; }
+#endif
         SK_STORE(pa, ar); SK_STORE(pa + SK_W, ai);
         SK_STORE(pb, br); SK_STORE(pb + SK_W, bi);
         SK_STORE(pc, cr); SK_STORE(pc + SK_W, ci);
@@ -119,12 +135,17 @@
         // and entropy-preserving. Measured +3.2 W avx2 / +1.0 W scalar on the
         // 5700X (P045): package power tracks the cache-traffic rate, and this
         // raises bytes/block ~50% for ~6% more instructions.
+#ifndef SK_ABL_NOFAR
         {
           size_t jf;
+#ifdef SK_X_FARSTRIDE
+          jf = ((j * SK_X_FARSTRIDE) & (kVecs - 1)) ^ (kVecs / 2);
+#else
           if constexpr ((kVecs & (kVecs - 1)) == 0)
             jf = j ^ (kVecs / 2);
           else
             jf = SynthFarVector(j, kVecs);
+#endif
           double *pf = buf + jf * 2 * SK_W;
           double *pg = buf + (jf ^ (size_t)1) * 2 * SK_W;
           SK_VEC t1_ = SK_LOAD(pf), t2_ = SK_LOAD(pf + SK_W);
@@ -132,15 +153,60 @@
           t1_ = SK_LOAD(pg); t2_ = SK_LOAD(pg + SK_W);
           SK_STORE(pg, t2_); SK_STORE(pg + SK_W, t1_);
         }
+#ifdef SK_X_FAR2
+        {
+          const size_t jq = j ^ (kVecs / 4);
+          double *pq = buf + jq * 2 * SK_W;
+          double *pr = buf + (jq ^ (size_t)1) * 2 * SK_W;
+          SK_VEC t1_ = SK_LOAD(pq), t2_ = SK_LOAD(pq + SK_W);
+          SK_STORE(pq, t2_); SK_STORE(pq + SK_W, t1_);
+          t1_ = SK_LOAD(pr); t2_ = SK_LOAD(pr + SK_W);
+          SK_STORE(pr, t2_); SK_STORE(pr + SK_W, t1_);
+        }
+#endif
+#ifdef SK_X_FARN
+        for (size_t k_ = 2; k_ < SK_X_FARN; k_ += 2) {
+          const size_t jq = (((j * SK_X_FARSTRIDE) & (kVecs - 1)) ^ (kVecs / 2)) ^ k_;
+          double *pq = buf + jq * 2 * SK_W;
+          double *pr = buf + (jq ^ (size_t)1) * 2 * SK_W;
+          SK_VEC t1_ = SK_LOAD(pq), t2_ = SK_LOAD(pq + SK_W);
+          SK_STORE(pq, t2_); SK_STORE(pq + SK_W, t1_);
+          t1_ = SK_LOAD(pr); t2_ = SK_LOAD(pr + SK_W);
+          SK_STORE(pr, t2_); SK_STORE(pr + SK_W, t1_);
+        }
+#endif
+#ifdef SK_X_FAR4
+        {
+          const size_t jq = (j ^ (kVecs / 2)) ^ (size_t)2;
+          double *pq = buf + jq * 2 * SK_W;
+          double *pr = buf + (jq ^ (size_t)1) * 2 * SK_W;
+          SK_VEC t1_ = SK_LOAD(pq), t2_ = SK_LOAD(pq + SK_W);
+          SK_STORE(pq, t2_); SK_STORE(pq + SK_W, t1_);
+          t1_ = SK_LOAD(pr); t2_ = SK_LOAD(pr + SK_W);
+          SK_STORE(pr, t2_); SK_STORE(pr + SK_W, t1_);
+        }
+#endif
+#endif
 
+#ifdef SK_X_IMM32
+        g0 = Rotl64(g0 * 0xFFFFFFFF9E3779B1ull, 29) ^ g4;
+        g1 = Rotl64(g1 * 0xFFFFFFFFBF58476Dull, 31) ^ g5;
+        g2 = Rotl64(g2 * 0xFFFFFFFF94D049BBull, 27) ^ g6;
+        g3 = Rotl64(g3 * 0xFFFFFFFFD6E8FEB9ull, 33) ^ g7;
+#else
         g0 = Rotl64(g0 * 0x9E3779B97F4A7C15ull, 29) ^ g4;
         g1 = Rotl64(g1 * 0xBF58476D1CE4E5B9ull, 31) ^ g5;
         g2 = Rotl64(g2 * 0x94D049BB133111EBull, 27) ^ g6;
         g3 = Rotl64(g3 * 0xD6E8FEB86659FD93ull, 33) ^ g7;
+#endif
         g4 += g1;
         g5 += g2;
         g6 += g3;
+#ifndef SK_ABL_NODIV
         g7 ^= g5 / ((g0 >> 31) | 0x100000001ull);
+#else
+        g7 ^= g5 + ((g0 >> 31) | 0x100000001ull);
+#endif
       }
     }
     blocks += kVecs / 4;
